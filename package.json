{
  "name": "acbu-backend",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=10.0.0"
  },
  "description": "ACBU Backend API Server",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "prisma/schema.prisma",
    "prisma/migrations/",
    "README.md"
  ],
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "pnpm run build",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest --coverage",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --detectOpenHandles",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "backfill:org-limits": "ts-node --transpile-only prisma/backfillOrgTransactionContext.ts",
    "backfill:kyc-encryption": "ts-node --transpile-only scripts/backfillKycEncryption.ts",
    "stellar:create-wallet": "ts-node --transpile-only scripts/create-stellar-wallet.ts",
    "compute:basket-weights": "ts-node --transpile-only scripts/compute-basket-weights.ts",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "acbu",
    "stablecoin",
    "africa",
    "fintech"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@prisma/client": "^5.19.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@stellar/stellar-sdk": "^15.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/decimal.js": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.39",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.6",
    "amqplib": "^0.10.3",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "escape-string-regexp": "^5.0.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "localforage": "^1.10.0",
    "mongodb": "^6.3.0",
    "nodemailer": "^9.0.1",
    "openai": "^6.32.0",
    "otplib": "^12.0.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "typescript": "^5.3.3",
    "uuid": "^14.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "conventional-changelog": "^6.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "openapi-schema-validator": "^12.1.3",
    "prettier": "^3.2.4",
    "prisma": "^5.19.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.3.6",
      "handlebars": ">=4.7.9",
      "minimatch": ">=3.1.4",
      "flatted": ">=3.4.2",
      "path-to-regexp": "^0.1.13"
    }
  }
}
