# Local-only overrides for development.
# Keep secrets out of version control and customize these values for your machine.

NODE_ENV=development
PORT=5000

# Local service endpoints
DATABASE_URL=postgresql://acbu_user:acbu_pass@localhost:5432/acbu_db
MONGODB_URI=mongodb://localhost:27017/acbu_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=dev-jwt-secret-change-me

# Example local web client origin
CORS_ORIGIN=http://localhost:3000

# Optional local S3-compatible storage settings
S3_BUCKET=acbu-kyc-documents
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=local-dev-access-key
AWS_SECRET_ACCESS_KEY=local-dev-secret-key

# Stellar testnet defaults
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
USDC_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
